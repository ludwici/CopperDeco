{
  "schemaVersion": 1,
  "id": "copperdeco",
  "version": "${version}",
  "name": "Copper Deco",
  "description": "Adds 32 decorative copper tile variants for walls, floors and ceilings, with oxidation, waxing and scraping.",
  "authors": [
    "ludwici"
  ],
  "license": "MIT",
  "icon": "copperdeco.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ludwici.copperdeco.CopperDeco"
    ],
    "client": [
      "com.ludwici.copperdeco.CopperDecoClient"
    ]
  },
  "mixins": [
    "copperdeco.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "carpetscore": ">=1.1.0",
    "vanillabackport": ">=1.2.2"
  },
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/copper-deco",
    "sources": "https://github.com/ludwici/CopperDeco",
    "issues": "https://github.com/ludwici/CopperDeco/issues"
  }
}
